<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cmp.mall.mapper.ProductMapper">

    <resultMap id="ProductMap" type="com.cmp.mall.entity.Product">
        <id column="productid" property="productId"/>
        <result column="category" property="category"/>
        <result column="name" property="name"/>
        <result column="descn" property="descn"/>
        <result column="min_price" property="minPrice"/>
    </resultMap>

    <sql id="Base_Column_List">
        p.productid, p.category, p.name, p.descn
    </sql>

    <!--
      动态 SQL：categoryId 与 keyword 都可以为空。
      原版在 Java 里用 StringBuilder 拼 WHERE 再拼参数列表，容易出现漏加引号与注入风险；
      这里交给 MyBatis 的 if 标签，参数统一由 #{} 预编译。

      LEFT JOIN + MIN 聚合出最低价，让列表页能显示"¥16.50 起"，
      避免前端为每个商品再发一次 SKU 请求（典型的 N+1）。
    -->
    <select id="findByCategory" resultMap="ProductMap">
        SELECT
        <include refid="Base_Column_List"/>,
        MIN(i.listprice) AS min_price
        FROM product p
        LEFT JOIN item i ON i.productid = p.productid
        <where>
            <if test="categoryId != null and categoryId != ''">
                AND p.category = #{categoryId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (p.name LIKE CONCAT('%', #{keyword}, '%')
                     OR p.descn LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        GROUP BY p.productid, p.category, p.name, p.descn
        ORDER BY p.productid
    </select>

    <select id="findById" resultMap="ProductMap">
        SELECT
        <include refid="Base_Column_List"/>,
        (SELECT MIN(listprice) FROM item WHERE productid = p.productid) AS min_price
        FROM product p
        WHERE p.productid = #{productId}
    </select>

    <select id="searchByKeyword" resultMap="ProductMap">
        SELECT
        <include refid="Base_Column_List"/>,
        MIN(i.listprice) AS min_price
        FROM product p
        LEFT JOIN item i ON i.productid = p.productid
        <where>
            <if test="keyword != null and keyword != ''">
                (p.name LIKE CONCAT('%', #{keyword}, '%')
                 OR p.descn LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        GROUP BY p.productid, p.category, p.name, p.descn
        ORDER BY p.productid
    </select>

</mapper>
